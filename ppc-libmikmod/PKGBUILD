# Maintainer: Extrems <extrems@extremscorner.org>

_pkgname=libmikmod
pkgname="ppc-${_pkgname}"
pkgver=3.3.14
pkgrel=1
pkgdesc='Module player library supporting many formats, including MOD, S3M, IT and XM.'
arch=('any')
url='https://mikmod.sourceforge.net/'
license=('LGPL-2.0-or-later')
groups=('ppc-portlibs')
depends=('devkitPPC')
makedepends=('cmake' 'libogc2-dkp-toolchain-vars')
options=(!strip libtool staticlibs)
source=("https://downloads.sourceforge.net/sourceforge/mikmod/${_pkgname}-${pkgver}.tar.gz")
sha256sums=('dffd82b8f254c3489c32098da831f33eac7136843d1e7ccb802f1254ad5b4219')

build() {
	cd "${srcdir}/${_pkgname}-${pkgver}"
	source "${DEVKITPRO}/libogc2/ppcvars.sh"
	powerpc-eabi-cmake -B build -DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}" -DENABLE_DOC=OFF -DENABLE_SHARED=OFF -DHAVE_PTHREAD=ON
	cmake --build build
}

package() {
	cd "${srcdir}/${_pkgname}-${pkgver}"
	source "${DEVKITPRO}/libogc2/ppcvars.sh"
	DESTDIR="${pkgdir}" cmake --install build
	install -Dm 644 libmikmod.m4 -t "${pkgdir}${PORTLIBS_PREFIX}/share/aclocal"
	install -Dm 644 COPYING.{LESSER,LIB} -t "${pkgdir}${PORTLIBS_PREFIX}/licenses/${pkgname}"
}
