# Maintainer: Extrems <extrems@extremscorner.org>

_pkgname=SDL_mixer
pkgname="libogc2-${_pkgname,,}"
pkgver=1.2.12.r187.g4936c70
pkgrel=2
pkgdesc='A simple multi-channel audio mixer.'
arch=('any')
url='https://github.com/libsdl-org/SDL_mixer'
license=('Zlib')
groups=('gamecube-portlibs' 'gamecube-sdl-libs' 'wii-portlibs' 'wii-sdl-libs')
depends=('devkitPPC' 'libogc2-sdl' 'ppc-flac' 'ppc-libmikmod' 'ppc-libvorbis' 'ppc-mpg123')
makedepends=('git' 'libogc2-dkp-toolchain-vars')
options=(!strip libtool staticlibs)
source=("git+${url}.git#commit=4936c70895f464e68941fc9dbf097bfb4579475a"
		"${_pkgname}.patch")
sha256sums=('4c33f28a5356f810a0094e7ffa1dc31eb5062d33df225d6d3529da80a5c5747b'
			'3d15bab46ff0b575f2a54ec133f42923865c39b4c53b3f8d0e0650db3d1ffc82')

prepare() {
	cd "${srcdir}/${_pkgname}"
	git apply "${srcdir}/${_pkgname}.patch"
}

pkgver() {
	cd "${srcdir}/${_pkgname}"
	git describe --tags --abbrev=7 | sed 's/^release-//;s/-/.r/;s/-/./'
}

build() {
	for platform in gamecube wii; do
		source "${DEVKITPRO}/libogc2/${platform}vars.sh"
		mkdir -p "${srcdir}/${_pkgname}/build-${platform}" && cd "${_}"
		../configure --prefix="${PORTLIBS_PREFIX}" --host=powerpc-eabi --disable-music-cmd
		make
	done
}

package() {
	for platform in gamecube wii; do
		cd "${srcdir}/${_pkgname}/build-${platform}"
		source "${DEVKITPRO}/libogc2/${platform}vars.sh"
		DESTDIR="${pkgdir}" make install
		install -Dm 644 ../COPYING -t "${pkgdir}${PORTLIBS_PREFIX}/share/licenses/${_pkgname}"
	done
}
