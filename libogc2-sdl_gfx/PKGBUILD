# Maintainer: Extrems <extrems@extremscorner.org>

_pkgname=SDL_gfx
pkgname="libogc2-${_pkgname,,}"
pkgver=2.0.27
pkgrel=2
pkgdesc='SDL graphics drawing primitives and other support functions.'
arch=('any')
url='https://www.ferzkopp.net/wordpress/2016/01/02/sdl_gfx-sdl2_gfx/'
license=('Zlib')
groups=('gamecube-portlibs' 'gamecube-sdl-libs' 'wii-portlibs' 'wii-sdl-libs')
depends=('devkitPPC' 'libogc2-sdl')
makedepends=('libogc2-dkp-toolchain-vars')
options=(!strip libtool staticlibs)
source=("https://www.ferzkopp.net/Software/SDL_gfx-2.0/${_pkgname}-${pkgver}.tar.gz")
sha256sums=('dfb15ac5f8ce7a4952dc12d2aed9747518c5e6b335c0e31636d23f93c630f419')

prepare() {
	for platform in gamecube wii; do
		cd "${srcdir}/${_pkgname}-${pkgver}"
		source "${DEVKITPRO}/libogc2/${platform}vars.sh"
		./autogen.sh
	done
}

build() {
	for platform in gamecube wii; do
		source "${DEVKITPRO}/libogc2/${platform}vars.sh"
		mkdir -p "${srcdir}/${_pkgname}-${pkgver}/build-${platform}" && cd "${_}"
		../configure --prefix="${PORTLIBS_PREFIX}" --host=powerpc-eabi --enable-mmx=no
		make
	done
}

package() {
	for platform in gamecube wii; do
		cd "${srcdir}/${_pkgname}-${pkgver}/build-${platform}"
		source "${DEVKITPRO}/libogc2/${platform}vars.sh"
		DESTDIR="${pkgdir}" make install
		install -Dm 644 ../LICENSE -t "${pkgdir}${PORTLIBS_PREFIX}/share/licenses/${_pkgname}"
	done
}
