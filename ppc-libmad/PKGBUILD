# Maintainer: Extrems <extrems@extremscorner.org>

_pkgname=libmad
pkgname="ppc-${_pkgname}"
pkgver=0.16.5
pkgrel=1
pkgdesc='A high-quality MPEG audio decoder.'
arch=('any')
url='https://codeberg.org/tenacityteam/libmad'
license=('GPL-2.0-or-later')
groups=('ppc-portlibs')
depends=('devkitPPC')
makedepends=('cmake' 'libogc2-dkp-toolchain-vars' 'patch')
options=(!strip libtool staticlibs)
source=("${_pkgname}-${pkgver}.tar.gz::${url}/archive/${pkgver}.tar.gz"
		"${_pkgname}-${pkgver}.patch")
sha256sums=('e32320a010e3cc00bfa66e0cde523a969313cddfd81e07ec4e3ef06d10ad3fe0'
			'ac94319d51a1227563b3246b18b88c3786c1dfb8d7102cb0396b4f8897b94000')

prepare() {
	patch -Np 0 -i "${_pkgname}-${pkgver}.patch"
}

build() {
	cd "${srcdir}/${_pkgname}"
	source "${DEVKITPRO}/libogc2/ppcvars.sh"
	powerpc-eabi-cmake -B build -DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}"
	cmake --build build
}

package() {
	cd "${srcdir}/${_pkgname}"
	source "${DEVKITPRO}/libogc2/ppcvars.sh"
	DESTDIR="${pkgdir}" cmake --install build
	install -Dm 644 COPYING -t "${pkgdir}${PORTLIBS_PREFIX}/licenses/${pkgname}"
}
