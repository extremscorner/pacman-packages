# Maintainer: Extrems <extrems@extremscorner.org>

_pkgname=libzip
pkgname="ppc-${_pkgname}"
pkgver=1.12
pkgrel=1
pkgdesc='C library for reading, creating, and modifying zip archives.'
arch=('any')
url='https://libzip.org/'
license=('BSD-3-Clause')
groups=('ppc-portlibs')
depends=('devkitPPC' 'ppc-libbz2' 'ppc-liblzma' 'ppc-libzstd' 'ppc-zlib')
makedepends=('cmake' 'libogc2-dkp-toolchain-vars' 'patch')
options=(!strip libtool staticlibs)
source=("${url}/download/${_pkgname}-${pkgver}.tar.xz"
		"${_pkgname}-${pkgver}.patch")
sha256sums=('376908d0f0fda13180a19fdc4f7062a1abfb59e09ca07a392d361253b8e60c2b'
			'3bdcfe7a4fb1735e9ff344023db63629e7a4c799410ddeaa1c336b44b0e21e94')

prepare() {
	patch -Np 0 -i "${_pkgname}-${pkgver}.patch"
}

build() {
	cd "${srcdir}/${_pkgname}-${pkgver}"
	source "${DEVKITPRO}/libogc2/ppcvars.sh"
	powerpc-eabi-cmake -B build -DBUILD_DOC=OFF -DBUILD_EXAMPLES=OFF -DBUILD_OSSFUZZ=OFF -DBUILD_REGRESS=OFF -DBUILD_SHARED_LIBS=OFF -DBUILD_TOOLS=OFF -DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX}" -DCMAKE_PREFIX_PATH="${PORTLIBS_PREFIX}" -DZLIB_LINK_LIBRARY_NAME=z
	cmake --build build
}

package() {
	cd "${srcdir}/${_pkgname}-${pkgver}"
	source "${DEVKITPRO}/libogc2/ppcvars.sh"
	DESTDIR="${pkgdir}" cmake --install build
	install -Dm 644 LICENSE -t "${pkgdir}${PORTLIBS_PREFIX}/licenses/${pkgname}"
}
