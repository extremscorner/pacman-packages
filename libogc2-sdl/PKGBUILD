# Maintainer: Extrems <extrems@extremscorner.org>

_pkgname=SDL
pkgname="libogc2-${_pkgname,,}"
pkgver=1.2.15
pkgrel=23
pkgdesc='A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard.'
arch=('any')
url='https://www.libsdl.org/'
license=('LGPL-2.1-or-later')
groups=('gamecube-portlibs' 'gamecube-sdl-libs' 'wii-portlibs' 'wii-sdl-libs')
depends=('devkitPPC' 'libogc2' 'libogc2-libfat')
makedepends=('git' 'libogc2-dkp-toolchain-vars' 'libogc2-glu' 'libogc2-opengx' 'ppc-libiconv')
optdepends=('libogc2-glu: OpenGL support'
			'libogc2-opengx: OpenGL support'
			'ppc-libiconv: iconv support')
options=(!strip libtool staticlibs)
source=('git+https://github.com/extremscorner/SDL.git#commit=1dd9ada824eead9da2e76fd29ccccd0252630461')
sha256sums=('e6a8aaefe7bdbab2dc090af156e5cb1cc290f0628606313b4370e71f070debb7')

prepare() {
	cd "${srcdir}/${_pkgname}"
	./autogen.sh
}

build() {
	for platform in gamecube wii; do
		source "${DEVKITPRO}/libogc2/${platform}vars.sh"
		mkdir -p "${srcdir}/${_pkgname}/build-${platform}" && cd "${_}"
		../configure --prefix="${PORTLIBS_PREFIX}" --host=powerpc-eabi --enable-nintendo-${platform} ac_cv_func_iconv=yes
		make
	done
}

package() {
	for platform in gamecube wii; do
		cd "${srcdir}/${_pkgname}/build-${platform}"
		source "${DEVKITPRO}/libogc2/${platform}vars.sh"
		DESTDIR="${pkgdir}" make install
		rm -r "${pkgdir}${PORTLIBS_PREFIX}/share/man"
		install -Dm 644 ../COPYING -t "${pkgdir}${PORTLIBS_PREFIX}/share/licenses/${_pkgname}"
	done
}
